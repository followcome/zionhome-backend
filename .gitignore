
node_modules/

.env

.env.*

dist/


coverage/

# ===========================================
# LOGS
# ===========================================
# Log files are generated during development/debugging
# They can contain sensitive information and grow large
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================================
# OPERATING SYSTEM FILES
# ===========================================
# .DS_Store is created by macOS in every folder
# Thumbs.db is created by Windows for image thumbnails
# These are useless system files
.DS_Store
Thumbs.db
